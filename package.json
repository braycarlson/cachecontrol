{
    "name": "cachecontrol",
    "version": "2.0.0",
    "description": "An extension to disable cache for specified websites.",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "bun run build:firefox && bun run build:chrome",
        "build:chrome": "TARGET=chrome vite build",
        "build:firefox": "TARGET=firefox vite build",
        "check": "vue-tsc --noEmit && eslint . && vitest run --coverage",
        "coverage": "vitest run --coverage",
        "dev": "bun run dev:firefox",
        "dev:chrome": "TARGET=chrome vite",
        "dev:firefox": "TARGET=firefox vite",
        "e2e": "bun run e2e:chromium && bun run e2e:firefox",
        "e2e:chromium": "bun run build:chrome && playwright test --config e2e/playwright.config.ts",
        "e2e:firefox": "bun run build:firefox && bun e2e/firefox/run.ts",
        "lint": "eslint .",
        "lint:extension": "web-ext lint --source-dir dist/firefox --no-config-discovery",
        "lint:fix": "eslint . --fix",
        "package": "bun run package:firefox && bun run package:chrome",
        "package:chrome": "bun run build:chrome && web-ext build --source-dir dist/chrome --artifacts-dir dist --filename cachecontrol-chrome.zip --overwrite-dest --no-config-discovery",
        "package:firefox": "bun run build:firefox && web-ext build --source-dir dist/firefox --artifacts-dir dist --filename cachecontrol-firefox.zip --overwrite-dest --no-config-discovery",
        "screenshot": "bun run build:chrome && bun e2e/screenshot.ts",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "vue-tsc --noEmit"
    },
    "dependencies": {
        "vue": "^3.5.41",
        "webextension-polyfill": "^0.12.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@fontsource/ibm-plex-sans": "^5.3.0",
        "@playwright/test": "^1.62.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.2.0",
        "@types/webextension-polyfill": "^0.12.5",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vitest/coverage-v8": "^4.1.10",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/test-utils": "^2.4.11",
        "@webext-core/fake-browser": "^2.0.1",
        "eslint": "^10.8.1",
        "eslint-plugin-vue": "^10.10.0",
        "fast-check": "^4.9.0",
        "globals": "^17.11.0",
        "happy-dom": "^20.11.2",
        "jiti": "^2.7.0",
        "tailwindcss": "^4.3.3",
        "typescript": "6.0.3",
        "typescript-eslint": "^8.67.0",
        "vite": "^8.2.1",
        "vite-plugin-web-extension": "^4.5.1",
        "vitest": "^4.1.10",
        "vue-eslint-parser": "^10.4.1",
        "vue-tsc": "^3.3.10",
        "web-ext": "^10.6.0"
    }
}
